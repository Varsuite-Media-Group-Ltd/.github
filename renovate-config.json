{
  "enabled": true,
  "extends": [
    "abandonments:recommended",
    "config:recommended",
    "docker:disable",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    "security:openssf-scorecard",
    ":automergePr",
    ":combinePatchMinorReleases",
    ":configMigration",
    ":prConcurrentLimit10",
    ":prImmediately",
    ":rebaseStalePrs",
    ":renovatePrefix",
    ":separateMultipleMajorReleases"
  ],
  "constraints": {
    "php": "<= 8.4.15"
  },
  "dependencyDashboardAutoclose": true,
  "ignoreDeps": [
    "mariadb"
  ],
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Varsuite's own pipeline is referenced at @v1, a tag scripts/release.sh moves on each release. Pinning it to a commit would freeze a repository on an old pipeline, so Renovate leaves it alone.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Varsuite-Media-Group-Ltd/github-actions"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "A major version can change behaviour the tests do not cover, and merging to main deploys. Majors open as PRs for a person to review and merge.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchDepNames": ["php"],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "^larastan/larastan",
        "^phpstan/"
      ],
      "groupName": "phpstan packages",
      "groupSlug": "phpstan",
      "separateMajorMinor": false
    },
    {
      "matchPackagePatterns": ["laravel/framework"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "^@inertiajs/inertia.*$"
      ],
      "groupName": "inertia",
      "separateMajorMinor": false
    },
    {
      "matchPackagePatterns": [
        "^pestphp/.*$"
      ],
      "groupName": "pest",
      "separateMajorMinor": false
    },
    {
      "matchPackagePatterns": [
        "^vite",
        "^laravel-vite-plugin",
        "^@vitejs/.*$"
      ],
      "groupName": "vite",
      "groupSlug": "vite",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "prettier-plugin-tailwindcss",
        "prettier-plugin-blade"
      ],
      "groupName": "prettier plugins",
      "separateMajorMinor": false
    }
  ],
  "platformAutomerge": true,
  "rangeStrategy": "update-lockfile",
  "reviewers": ["team:development"],
  "rollbackPrs": true,
  "schedule": ["* 8-16 * * 1"],
  "timezone": "Europe/London",
  "transitiveRemediation": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "reviewers": ["team:development"],
    "schedule": "at any time",
    "transitiveRemediation": true
  }
}
